from pyspark.sql import functions as F

# CONFIGURATION: Set your target table path here (catalog.schema.table)
table_name = "your_catalog.your_schema.your_table"

# Load the table into a DataFrame
df = spark.table(table_name)
total_rows = df.count()

profile_data = []

# List of numeric data types in Spark to target for statistics
numeric_types = ['int', 'bigint', 'smallint', 'tinyint', 'float', 'double', 'decimal']

print(f"Profiling table: {table_name} ({total_rows:,} total rows)...")

# Loop through every column and its data type
for col_name, data_type in df.dtypes:
    
    # Count missing (null) values
    null_count = df.filter(F.col(col_name).isNull()).count()
    null_pct = (null_count / total_rows) * 100 if total_rows > 0 else 0
    
    col_stats = {
        "column_name": col_name,
        "data_type": data_type,
        "missing_values": null_count,
        "missing_percentage": round(null_pct, 2),
        "min_val": None,
        "max_val": None,
        "avg_val": None,
        "median_val": None
    }
    
    # Compute stats if the column is numeric
    if any(t in data_type.lower() for t in numeric_types):
        stats = df.select(
            F.min(F.col(col_name)),
            F.max(F.col(col_name)),
            F.avg(F.col(col_name)),
            F.expr(f"percentile_approx(`{col_name}`, 0.5)") # Scalable median
        ).collect()[0]
        
        col_stats["min_val"] = stats[0]
        col_stats["max_val"] = stats[1]
        col_stats["avg_val"] = float(stats[2]) if stats[2] is not None else None
        col_stats["median_val"] = stats[3]
        
    profile_data.append(col_stats)

# Convert results into a Spark DataFrame and display
profile_df = spark.createDataFrame(profile_data)
display(profile_df)
